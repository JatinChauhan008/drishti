# CivicDataSpace API
CIVICDATA_BASE_URL=https://dev.api.civicdataspace.in

# Primary chat LLM (OpenAI-compatible /chat/completions endpoint)
SARVAM_API_KEY=your_sarvam_api_key_here
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
LLM_MAX_TOKENS=8192
CHAT_HISTORY_MESSAGES=12

# Live trace console (log_server.py) -- run it in its own terminal:
#   python log_server.py
# then open http://127.0.0.1:8001
LOG_SERVER_PORT=8001

# OpenRouter judge -- verifies each answer against the sources the tools
# retrieved. Leave OPENROUTER_API_KEY unset to disable judging entirely.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost
JUDGE_MODEL=openai/gpt-4o-mini
ENABLE_JUDGE=true
